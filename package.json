{
  "name": "dsh-team-member-model",
  "version": "0.7.12",
  "engines": { "dsh": ">=0.2.2-rc.3" },
  "private": true,
  "description": "子 agent 模型路由与用量统计：按 magpie 的 Group/Rule 语义，在 subagent / subagent_fork / 团队成员 / workflow 创建时决定跑哪个模型，运行期可重试失败延期至下轮按候选回退（当次失败如实交官方）；Lead 自己的模型永不参与。自带路由设置页，关闭插件即回到官方行为。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./rules": {
      "default": "./lib/rules.js"
    },
    "./usage": {
      "default": "./lib/usage.js"
    },
    "./skill": {
      "default": "./lib/skill.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./team-state": {
      "default": "./lib/team-state.js"
    },
    "./team-routing": {
      "default": "./lib/team-routing.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/rules.js",
    "lib/usage.js",
    "lib/skill.js",
    "lib/team-state.js",
    "lib/team-routing.js",
    "skills/model-routing/SKILL.md",
    "lib/client.js",
    "cordis.patch.yml",
    "docs/model-routing-guide.md",
    "docs/spec.md",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0"
  }
}
